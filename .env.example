# Copy to .env and fill in the keys for the providers you want to run "live".
# Any provider WITHOUT a key here automatically runs in LiteLLM mock mode, so
# the gateway always starts and failover always has somewhere to go.

# Set to 1 to force ALL providers into mock mode (offline failover demo).
GATEWAY_FORCE_MOCK=0

# Provider keys (LiteLLM reads these vendor model strings):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local open-source model via Ollama (no key needed; needs Ollama running).
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Seconds to wait on an upstream before treating it as failed.
GATEWAY_UPSTREAM_TIMEOUT=30
